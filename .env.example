# Copy this file to .env before running `make up` / `docker compose up`.
#
# These are placeholders: CoinGecko's free tier needs no key, and news-service
# currently serves a mocked fallback feed (real NewsAPI wiring is not yet
# implemented — see README.md), so neither variable is read by the running
# services yet. They're kept here so docker-compose has something to
# interpolate and so the intent is documented for when that wiring lands.
MARKET_API_KEY=
NEWS_API_KEY=
