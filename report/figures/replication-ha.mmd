graph LR
    subgraph PG["PostgreSQL (per database)"]
        direction LR
        Primary[("primary")] -->|streaming<br/>replication, async| Standby[("standby")]
    end

    subgraph RD["Redis"]
        direction TB
        S1["sentinel-1"]
        S2["sentinel-2"]
        S3["sentinel-3"]
        RM[("redis<br/>master")]
        RR[("redis<br/>replica")]
        S1 -.->|monitor| RM
        S2 -.->|monitor| RM
        S3 -.->|monitor| RM
        RM -->|replication| RR
    end

    Note1["quorum = 2 of 3<br/>promotes RR on RM failure"]
    RD --- Note1
