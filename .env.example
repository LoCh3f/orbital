# Copy this file to .env before running `make up` / `docker compose up`.
#
# These are placeholders: CoinGecko's free tier needs no key, and news-service
# currently serves a mocked fallback feed (real NewsAPI wiring is not yet
# implemented — see README.md), so neither variable is read by the running
# services yet. They're kept here so docker-compose has something to
# interpolate and so the intent is documented for when that wiring lands.
MARKET_API_KEY=
NEWS_API_KEY=

# Optional gateway configuration — see README.md's "Gateway Configuration" section.
# Uncomment and set only if you know you need them; the gateway is safe by default without any of these.
# CORS_ALLOWED_HOST=
# REDIS_URL=
# TRUST_PROXY_HEADERS=

# Password for the Postgres replication role both postgres-market and postgres-news create for
# their respective standby (postgres-market-replica / postgres-news-replica) to connect as.
# UNVERIFIED replication setup — see database/replica-entrypoint.sh. Defaults to a placeholder if
# unset; override before anything resembling a real deployment.
# POSTGRES_REPLICATION_PASSWORD=

# Postgres credentials for the market_data and news_data databases, and the admin passwords for the
# Grafana and pgAdmin consoles docker-compose exposes on host ports 3000 and 5050. All default to
# known, committed placeholder values if unset — fine for local dev, but every one of these MUST be
# overridden before deploying anywhere reachable over a network.
# POSTGRES_MARKET_PASSWORD=
# POSTGRES_NEWS_PASSWORD=
# GRAFANA_ADMIN_PASSWORD=
# PGADMIN_ADMIN_PASSWORD=
