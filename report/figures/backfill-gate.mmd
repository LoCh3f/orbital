flowchart TD
    Poll["Top-20 snapshot polling"] --> Track["Update active coins and verified pairs"]
    View["User selects range or zoom"] --> Queue[("Durable import jobs")]
    Track --> Queue
    Queue --> Pick["Single worker: active coin, priority, retry time"]
    Pick --> Source{"Source"}
    Source -->|Binance USDT| List["List monthly / daily archive files"]
    List --> Pending["Skip completed files<br/>Take at most 2 files"]
